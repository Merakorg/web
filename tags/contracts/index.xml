          &lt;th&gt;Network&lt;/th&gt;
          &lt;th&gt;URL&lt;/th&gt;
      &lt;/tr&gt;
  &lt;/thead&gt;
  &lt;tbody&gt;
      &lt;tr&gt;
          &lt;td&gt;BSC&lt;/td&gt;
          &lt;td&gt;&lt;a href=&#34;https://pancakeswap.finance/&#34;&gt;https://pancakeswap.finance/&lt;/a&gt;&lt;/td&gt;
